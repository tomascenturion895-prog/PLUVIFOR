# Copiar a ".env" y completar. El archivo ".env" NUNCA se sube al repositorio.
# Este archivo solo lleva nombres de variables y valores de ejemplo, sin secretos reales.

# ---- General ----
# development | test | production
APP_ENV=development

# ---- Backend ----
# SQLite por defecto. Para PostgreSQL: postgresql+psycopg://usuario:clave@host:5432/pluvifor
DATABASE_URL=sqlite:///./pluvifor.db

# Orígenes permitidos por CORS, separados por coma (sin "*").
CORS_ORIGINS=http://localhost:5173

# Fecha de corte de los datos del prototipo (formato AAAA-MM-DD).
DATA_CUTOFF_DATE=2026-10-31

# Clave de administrador para operaciones de escritura (importar/confirmar).
# Sin clave, la escritura queda deshabilitada (403). Se envía en el encabezado X-API-Key.
# En desarrollo, poné una cualquiera en tu .env; en producción, una larga y aleatoria.
ADMIN_API_KEY=

# Clave de los dispositivos (sensores simulados) que envían lecturas. Vacía = ingesta cerrada.
# No es la de administración. Ver docs/ingesta-sensores.md.
DEVICE_API_KEY=

# Tamaño máximo (bytes) del cuerpo de cualquier pedido que no sea una importación.
MAX_REQUEST_BYTES=65536
# Tamaño máximo (bytes) de un archivo a importar.
MAX_UPLOAD_BYTES=5242880

# Pedidos por minuto y por dirección (0 desactiva el límite): general y de importación.
RATE_LIMIT_PER_MINUTE=120
RATE_LIMIT_IMPORT_PER_MINUTE=10

# ---- API en Go ----
# Puerto de la API en Go y dirección del backend en Python al que reenvía /api/*.
API_GO_PORT=8080
BACKEND_URL=http://127.0.0.1:8000
# Pedidos por minuto y por cliente que limita Go (0 desactiva): general y de importación.
# Con Go adelante, Python ve a todos desde la misma dirección (127.0.0.1): ponele
# RATE_LIMIT_PER_MINUTE=0 y RATE_LIMIT_IMPORT_PER_MINUTE=0 a Python y no lo expongas a Internet.
API_GO_RATE_LIMIT_PER_MINUTE=120
API_GO_RATE_LIMIT_IMPORT_PER_MINUTE=10

# ---- Frontend (Vite) ----
VITE_API_URL=http://localhost:8000
