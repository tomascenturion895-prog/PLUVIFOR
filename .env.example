# Copiar a ".env" y completar. El archivo ".env" NUNCA se sube al repositorio.
# Este archivo solo lleva nombres de variables y valores de ejemplo, sin secretos reales.

# ---- General ----
# development | test | production
APP_ENV=development

# ---- Backend ----
# SQLite por defecto. Para PostgreSQL: postgresql+psycopg://usuario:clave@host:5432/pluvifor
DATABASE_URL=sqlite:///./pluvifor.db

# Orígenes permitidos por CORS, separados por coma (sin "*").
CORS_ORIGINS=http://localhost:5173

# Fecha de corte de los datos del prototipo (formato AAAA-MM-DD).
DATA_CUTOFF_DATE=2026-10-31

# Clave de administrador para operaciones de escritura (importar/confirmar).
# Dejar vacía en desarrollo; generar una larga y aleatoria en producción.
ADMIN_API_KEY=

# ---- Frontend (Vite) ----
VITE_API_URL=http://localhost:8000
