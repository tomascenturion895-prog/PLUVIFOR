        "type": "string",
        "enum": [
          "observado",
          "referencia",
          "estimado"
        ],
        "title": "DataCategory",
        "description": "Observado, referencia y estimado nunca se suman ni se promedian entre sí."
      },
      "DayOut": {
        "properties": {
          "obs_date": {
            "type": "string",
            "format": "date",
            "title": "Obs Date"
          },
          "state": {
