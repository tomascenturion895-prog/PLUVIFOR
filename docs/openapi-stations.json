    "/api/stations/{station_id}": {
      "get": {
        "tags": [
          "estaciones"
        ],
        "summary": "Ficha de una estación",
        "operationId": "get_station_api_stations__station_id__get",
        "parameters": [
          {
            "name": "station_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Station Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
