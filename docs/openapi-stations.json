          },
          "mm": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Mm"
          },
          "category": {
            "$ref": "#/components/schemas/DataCategory"
          },
          "source": {
            "type": "string",
            "title": "Source"
          },
