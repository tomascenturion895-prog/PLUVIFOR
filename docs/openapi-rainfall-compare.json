{
  "openapi": "3.1.0",
  "info": {
    "title": "PLUVIFOR · API",
    "description": "Reporte pluvial de Formosa. PROTOTIPO · AI LAB Misión: Código Formosa · no es una herramienta oficial.",
    "version": "0.1.0"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "sistema"
        ],
        "summary": "Estado del servicio",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/stations": {
      "get": {
        "tags": [
          "estaciones"
        ],
        "summary": "Catálogo de estaciones",
        "operationId": "list_stations_api_stations_get",
        "parameters": [
          {
            "name": "source",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 64
                },
                {
                  "type": "null"
                }
              ],
              "description": "Código de la fuente",
              "title": "Source"
            },
            "description": "Código de la fuente"
          },
          {
            "name": "network",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 100
                },
                {
                  "type": "null"
                }
              ],
              "description": "Red de medición",
              "title": "Network"
            },
            "description": "Red de medición"
          },
          {
            "name": "department",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 100
                },
                {
                  "type": "null"
                }
              ],
              "title": "Department"
            }
          },
          {
            "name": "zone",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 100
                },
                {
                  "type": "null"
                }
              ],
              "title": "Zone"
            }
          },
          {
            "name": "coords_status",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "$ref": "#/components/schemas/CoordsStatus"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Coords Status"
            }
          },
          {
            "name": "q",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 100
                },
                {
                  "type": "null"
                }
              ],
              "description": "Texto en nombre o localidad",
              "title": "Q"
            },
            "description": "Texto en nombre o localidad"
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 200,
              "minimum": 1,
              "default": 100,
              "title": "Limit"
            }
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 0,
              "title": "Offset"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StationList"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/stations/{station_id}": {
      "get": {
        "tags": [
          "estaciones"
        ],
        "summary": "Ficha de una estación",
        "operationId": "get_station_api_stations__station_id__get",
        "parameters": [
          {
            "name": "station_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Station Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StationOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/rainfall/compare": {
      "get": {
        "tags": [
          "lluvia"
        ],
        "summary": "Comparar series diarias de dos o más estaciones con advertencias de comparabilidad",
        "operationId": "compare_rainfall_api_rainfall_compare_get",
        "parameters": [
          {
            "name": "station_ids",
            "in": "query",
            "required": true,
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "IDs de estaciones a comparar (repetir parámetro o separados por coma)",
              "title": "Station Ids"
            },
            "description": "IDs de estaciones a comparar (repetir parámetro o separados por coma)"
          },
          {
            "name": "from",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date",
              "title": "From"
            }
          },
          {
            "name": "to",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date",
              "title": "To"
            }
          },
          {
            "name": "category",
            "in": "query",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/DataCategory",
              "default": "observado"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SeriesCompareOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/rainfall": {
      "get": {
        "tags": [
          "lluvia"
        ],
        "summary": "Serie diaria de una estación con cobertura y advertencias",
        "operationId": "get_rainfall_api_rainfall_get",
        "parameters": [
          {
            "name": "station_id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "title": "Station Id"
            }
          },
          {
            "name": "from",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date",
              "title": "From"
            }
          },
          {
            "name": "to",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date",
              "title": "To"
            }
          },
          {
            "name": "category",
            "in": "query",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/DataCategory",
              "default": "observado"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SeriesOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/import/audit": {
      "post": {
        "tags": [
          "importación"
        ],
        "summary": "Valida un archivo y devuelve el informe sin guardar nada",
        "operationId": "audit_api_import_audit_post",
        "parameters": [
          {
            "name": "source",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 50,
              "pattern": "^[a-z0-9_]+$",
              "default": "siga_inta",
              "title": "Source"
            }
          },
          {
            "name": "kind",
            "in": "query",
            "required": false,
            "schema": {
              "enum": [
                "stations",
                "rainfall"
              ],
              "type": "string",
              "default": "rainfall",
              "title": "Kind"
            }
          },
          {
            "name": "filename",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 255,
              "default": "archivo.csv",
              "title": "Filename"
            }
          },
          {
            "name": "x-api-key",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Api-Key"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ImportReportOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/import/commit": {
      "post": {
        "tags": [
          "importación"
        ],
        "summary": "Guarda lo aceptado y registra la carga en import_logs",
        "operationId": "commit_api_import_commit_post",
        "parameters": [
          {
            "name": "source",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 50,
              "pattern": "^[a-z0-9_]+$",
              "default": "siga_inta",
              "title": "Source"
            }
          },
          {
            "name": "kind",
            "in": "query",
            "required": false,
            "schema": {
              "enum": [
                "stations",
                "rainfall"
              ],
              "type": "string",
              "default": "rainfall",
              "title": "Kind"
            }
          },
          {
            "name": "filename",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 255,
              "default": "archivo.csv",
              "title": "Filename"
            }
          },
          {
            "name": "x-api-key",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Api-Key"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ImportReportOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/import/logs": {
      "get": {
        "tags": [
          "importación"
        ],
        "summary": "Historial de cargas registradas (la más nueva primero)",
        "operationId": "logs_api_import_logs_get",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 100,
              "minimum": 1,
              "default": 20,
              "title": "Limit"
            }
          },
          {
            "name": "x-api-key",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Api-Key"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ImportLogOut"
                  },
                  "title": "Response Logs Api Import Logs Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/reports/summary": {
      "post": {
        "tags": [
          "parte pluvial"
        ],
        "summary": "Parte pluvial de una o más estaciones en un período, con texto listo para copiar",
        "operationId": "summary_api_reports_summary_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReportRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReportOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CoordsStatus": {
        "type": "string",
        "enum": [
          "verificada",
          "pendiente"
        ],
        "title": "CoordsStatus"
      },
      "DataCategory": {
        "type": "string",
        "enum": [
          "observado",
          "referencia",
          "estimado"
        ],
        "title": "DataCategory",
        "description": "Observado, referencia y estimado nunca se suman ni se promedian entre sí."
      },
      "DayOut": {
        "properties": {
          "obs_date": {
            "type": "string",
            "format": "date",
            "title": "Obs Date"
          },
          "state": {
            "$ref": "#/components/schemas/RainState"
          },
          "mm": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Mm"
          },
          "category": {
            "$ref": "#/components/schemas/DataCategory"
          },
          "source": {
            "type": "string",
            "title": "Source"
          },
          "flags": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Flags"
          }
        },
        "type": "object",
        "required": [
          "obs_date",
          "state",
          "mm",
          "category",
          "source",
          "flags"
        ],
        "title": "DayOut"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status"
          },
          "version": {
            "type": "string",
            "title": "Version"
          },
          "env": {
            "type": "string",
            "title": "Env"
          },
          "data_cutoff_date": {
            "type": "string",
            "format": "date",
            "title": "Data Cutoff Date"
          }
        },
        "type": "object",
        "required": [
          "status",
          "version",
          "env",
          "data_cutoff_date"
        ],
        "title": "HealthResponse"
      },
      "ImportLogOut": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "source": {
            "type": "string",
            "title": "Source"
          },
          "mode": {
            "type": "string",
            "title": "Mode"
          },
          "status": {
            "type": "string",
            "title": "Status"
          },
          "filename": {
            "type": "string",
            "title": "Filename"
          },
          "sha256": {
            "type": "string",
            "title": "Sha256"
          },
          "rows_read": {
            "type": "integer",
            "title": "Rows Read"
          },
          "rows_accepted": {
            "type": "integer",
            "title": "Rows Accepted"
          },
          "rows_rejected": {
            "type": "integer",
            "title": "Rows Rejected"
          },
          "rejections_by_reason": {
            "additionalProperties": {
              "type": "integer"
            },
            "type": "object",
            "title": "Rejections By Reason"
          },
          "cutoff_applied": {
            "type": "string",
            "format": "date",
            "title": "Cutoff Applied"
          },
          "started_at": {
            "type": "string",
            "format": "date-time",
            "title": "Started At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "source",
          "mode",
          "status",
          "filename",
          "sha256",
          "rows_read",
          "rows_accepted",
          "rows_rejected",
          "rejections_by_reason",
          "cutoff_applied",
          "started_at"
        ],
        "title": "ImportLogOut"
      },
      "ImportReportOut": {
        "properties": {
          "filename": {
            "type": "string",
            "title": "Filename"
          },
          "sha256": {
            "type": "string",
            "title": "Sha256"
          },
          "mode": {
            "type": "string",
            "enum": [
              "audit",
              "commit"
            ],
            "title": "Mode"
          },
          "saved": {
            "type": "boolean",
            "title": "Saved"
          },
          "rows_read": {
            "type": "integer",
            "title": "Rows Read"
          },
          "rows_accepted": {
            "type": "integer",
            "title": "Rows Accepted"
          },
          "rows_rejected": {
            "type": "integer",
            "title": "Rows Rejected"
          },
          "rejections_by_reason": {
            "additionalProperties": {
              "type": "integer"
            },
            "type": "object",
            "title": "Rejections By Reason"
          },
          "rejections": {
            "items": {
              "$ref": "#/components/schemas/RejectionOut"
            },
            "type": "array",
            "title": "Rejections"
          },
          "rejections_truncated": {
            "type": "boolean",
            "title": "Rejections Truncated"
          },
          "inserted": {
            "type": "integer",
            "title": "Inserted"
          },
          "updated": {
            "type": "integer",
            "title": "Updated"
          }
        },
        "type": "object",
        "required": [
          "filename",
          "sha256",
          "mode",
          "saved",
          "rows_read",
          "rows_accepted",
          "rows_rejected",
          "rejections_by_reason",
          "rejections",
          "rejections_truncated",
          "inserted",
          "updated"
        ],
        "title": "ImportReportOut"
      },
      "IntenseEventOut": {
        "properties": {
          "obs_date": {
            "type": "string",
            "format": "date",
            "title": "Obs Date"
          },
          "mm": {
            "type": "number",
            "title": "Mm"
          },
          "level_mm": {
            "type": "number",
            "title": "Level Mm"
          }
        },
        "type": "object",
        "required": [
          "obs_date",
          "mm",
          "level_mm"
        ],
        "title": "IntenseEventOut"
      },
      "NotEvaluatedOut": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "reason": {
            "type": "string",
            "title": "Reason"
          }
        },
        "type": "object",
        "required": [
          "code",
          "reason"
        ],
        "title": "NotEvaluatedOut"
      },
      "RainState": {
        "type": "string",
        "enum": [
          "dato",
          "fila_sin_valor",
          "sin_fila"
        ],
        "title": "RainState",
        "description": "Estado de un día de una estación. Solo `DATO` lleva milímetros."
      },
      "RejectionOut": {
        "properties": {
          "line": {
            "type": "integer",
            "title": "Line"
          },
          "reason": {
            "type": "string",
            "title": "Reason"
          },
          "message": {
            "type": "string",
            "title": "Message"
          }
        },
        "type": "object",
        "required": [
          "line",
          "reason",
          "message"
        ],
        "title": "RejectionOut"
      },
      "ReportOut": {
        "properties": {
          "category": {
            "$ref": "#/components/schemas/DataCategory"
          },
          "date_from": {
            "type": "string",
            "format": "date",
            "title": "Date From"
          },
          "date_to": {
            "type": "string",
            "format": "date",
            "title": "Date To"
          },
          "data_cutoff_date": {
            "type": "string",
            "format": "date",
            "title": "Data Cutoff Date"
          },
          "clipped_to_cutoff": {
            "type": "boolean",
            "title": "Clipped To Cutoff"
          },
          "stations": {
            "items": {
              "$ref": "#/components/schemas/StationReportOut"
            },
            "type": "array",
            "title": "Stations"
          },
          "comparability_warnings": {
            "items": {
              "$ref": "#/components/schemas/WarningOut"
            },
            "type": "array",
            "title": "Comparability Warnings"
          },
          "not_evaluated": {
            "items": {
              "$ref": "#/components/schemas/NotEvaluatedOut"
            },
            "type": "array",
            "title": "Not Evaluated"
          },
          "text": {
            "type": "string",
            "title": "Text"
          },
          "notice": {
            "type": "string",
            "title": "Notice",
            "default": "PROTOTIPO · AI LAB Misión: Código Formosa · no es una herramienta oficial"
          }
        },
        "type": "object",
        "required": [
          "category",
          "date_from",
          "date_to",
          "data_cutoff_date",
          "clipped_to_cutoff",
          "stations",
          "comparability_warnings",
